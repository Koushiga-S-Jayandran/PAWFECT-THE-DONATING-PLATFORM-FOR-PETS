{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered donor profile tied to Firebase Auth UID",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the donor",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Indian phone number with +91 prefix and 10 digits",
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "consentAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of terms consent"
        },
        "consentVersion": {
          "type": "string",
          "description": "Version of terms agreed to, e.g. v1.0",
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "description": "Fixed donor role",
          "enum": ["DONOR"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created"
        }
      },
      "required": ["fullName", "phone", "consentAt", "consentVersion", "role", "createdAt"]
    },
    "LoginThrottle": {
      "title": "LoginThrottle",
      "description": "Per-email rate limiter tracking rolling 24-hour failed login attempts",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Attempt counter, up to 4"
        },
        "windowStart": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of current rolling window start"
        }
      },
      "required": ["count", "windowStart"]
    },
    "VerificationThrottle": {
      "title": "VerificationThrottle",
      "description": "Tracks verification email requests to enforce 60s cooldown and max 3 per hour",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Count of resend attempts in current hour"
        },
        "windowStart": {
          "type": "string",
          "format": "date-time",
          "description": "Start of the 1-hour window"
        },
        "lastSentAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent verification email sent"
        }
      },
      "required": ["count", "windowStart", "lastSentAt"]
    },
    "AdoptionListing": {
      "title": "AdoptionListing",
      "description": "Admin-moderated companion animal adoption listing in Tamil Nadu or Kerala",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "listerUid": { "type": "string", "maxLength": 128 },
        "listerType": { "type": "string", "enum": ["individual", "shelter"] },
        "verifiedShelter": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "species": { "type": "string", "enum": ["dog", "cat", "other"] },
        "breed": { "type": "string", "minLength": 2, "maxLength": 80 },
        "ageMonths": { "type": "integer" },
        "gender": { "type": "string", "enum": ["male", "female", "unknown"] },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "story": { "type": "string", "minLength": 30, "maxLength": 1000 },
        "stateCode": { "type": "string", "enum": ["TN", "KL"] },
        "district": { "type": "string", "minLength": 2, "maxLength": 80 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "changes_requested", "adopted", "on_hold", "expired_hidden"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "listerUid", "listerType", "verifiedShelter", "name", "species", "story", "stateCode", "status", "createdAt", "updatedAt"]
    },
    "ListingPrivateContact": {
      "title": "ListingPrivateContact",
      "description": "Protected lister mobile number, accessible only to lister, admin, or accepted adopter",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "maxLength": 128 },
        "listerUid": { "type": "string", "maxLength": 128 },
        "contactName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "phone": { "type": "string", "pattern": "^\\+91[6-9][0-9]{9}$" },
        "revealOnlyToApproved": { "type": "boolean" },
        "otpVerifiedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "listerUid", "contactName", "phone", "revealOnlyToApproved"]
    },
    "AdoptionRequest": {
      "title": "AdoptionRequest",
      "description": "Adopter inquiry with deterministic ID {adopterId}_{listingId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "petId": { "type": "string", "maxLength": 128 },
        "adopterId": { "type": "string", "maxLength": 128 },
        "shelterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "petId", "adopterId", "shelterId", "status", "createdAt"]
    },
    "ListingReport": {
      "title": "ListingReport",
      "description": "Safety/scam report submitted against a listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "listingId": { "type": "string", "maxLength": 128 },
        "reporterUid": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "enum": ["suspected_sale", "fraud_or_upfront_fee", "animal_cruelty", "misleading_info", "other"] },
        "details": { "type": "string", "minLength": 10, "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "resolved_dismissed", "resolved_removed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "listingId", "reporterUid", "reason", "details", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Private user donor profile document accessible only by owner"
    },
    "/loginThrottle/{emailHash}": {
      "schema": "LoginThrottle",
      "description": "Login attempt counter indexed by SHA-256 hash of email"
    },
    "/verificationThrottle/{emailHash}": {
      "schema": "VerificationThrottle",
      "description": "Verification email attempt limiter indexed by SHA-256 hash of email"
    },
    "/adoptionListings/{listingId}": {
      "schema": "AdoptionListing",
      "description": "Admin-moderated animal adoption listings (no private phone)"
    },
    "/adoptionListings/{listingId}/private/contact": {
      "schema": "ListingPrivateContact",
      "description": "Restricted lister phone contact isolated from public listing"
    },
    "/adoptionRequests/{requestId}": {
      "schema": "AdoptionRequest",
      "description": "Adopter adoption interest applications"
    },
    "/listingReports/{reportId}": {
      "schema": "ListingReport",
      "description": "Moderation reports flagged by signed-in users"
    }
  }
}
